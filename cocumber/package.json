{
  "name": "mcq-cocumber",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "test:bdd": "pnpm exec cucumber-js --config cucumber.cjs",
    "test:bdd:watch": "pnpm exec cucumber-js --config cucumber.cjs --watch",
    "test:bdd:vigilante": "pnpm exec tsc --project tsconfig.json --noEmit && pnpm run test:bdd"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "@types/cucumber": "^7.0.4",
    "@types/node": "^20.14.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
